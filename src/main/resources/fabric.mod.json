{
	"schemaVersion": 1,
	"id": "map-washer",
	"version": "${version}",
	"name": "Map Washer",
	"description": "Get your filled maps empty again!",
	"authors": [
		"Orlisan"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/map-washer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.orlisan.mapwasher.MapWasher"
		],
		"client": [
			"io.github.orlisan.mapwasher.client.MapWasherClient"
		]
	},
	"mixins": [
		"map-washer.mixins.json",
		{
			"config": "map-washer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
